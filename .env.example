# --- Base de datos ---
POSTGRES_USER=moneytalk
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=moneytalk
# Desde el host (tests, scripts locales). Dentro de Docker la API usa db:5432.
DATABASE_URL=postgresql+psycopg://moneytalk:cambia-esto@127.0.0.1:5433/moneytalk
TEST_DATABASE_URL=postgresql+psycopg://moneytalk:cambia-esto@127.0.0.1:5433/moneytalk_test

# --- General ---
APP_TIMEZONE=America/Costa_Rica
LOG_LEVEL=INFO

# --- Gmail (solo lectura) ---
# credentials.json de un "OAuth client ID" tipo Desktop en Google Cloud Console.
GMAIL_CREDENTIALS_FILE=data/gmail_credentials.json
GMAIL_TOKEN_FILE=data/gmail_token.json
GMAIL_LABEL=Finanzas/Bancos

# --- Claude (categorización dudosa y resúmenes) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- BCCR: indicadores económicos (registro gratuito en gee.bccr.fi.cr) ---
BCCR_EMAIL=
BCCR_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Datos de mercado ---
MARKET_PROVIDER=yfinance
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
# SEC exige un User-Agent con contacto real: "NombreApp tu-correo@dominio"
SEC_USER_AGENT=MoneyTalk contacto@example.com
MARKET_CACHE_TTL_HOURS=12
